########################################
# Aliases
########################################
if command -v eza &> /dev/null; then
    alias ls="eza --icons=auto"
    alias ll="ls -l -a -H"
else
    alias ls="ls --color=auto"
    alias ll="ls -lah"
fi
alias l="ls"
alias szp="source ~/.zshrc"
alias zp="code ~/dotfiles"
alias clear_dns="sudo killall -HUP mDNSResponder"
