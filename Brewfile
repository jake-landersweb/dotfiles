# Core dependencies for these dotfiles. Install with: brew bundle
brew "stow"        # symlink manager used to install the packages
brew "git"
brew "gh"          # GitHub CLI (use `gh auth login` instead of a PAT)
brew "vim"

# Shell experience
brew "eza"         # modern ls (aliased in base.zsh)
brew "bat"         # cat/pager with syntax highlighting (MANPAGER + fzf previews)
brew "fzf"         # fuzzy finder + completion
brew "git-delta"   # `delta` — diff pager used in fzf-tab git previews

# Terminal
cask "ghostty"

# Optional / machine-specific — uncomment per laptop as needed:
# brew "asdf"            # runtime version manager
# brew "nvm"             # node version manager
# brew "granted"         # provides `assume` for AWS role switching
# brew "postgresql@18"
