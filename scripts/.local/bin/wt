#!/usr/bin/env bash
# wt — create a git worktree in ~/worktrees/<repo>/<name> the way I like it.
#
# Usage: wt <worktree_name> [branch_name]
#
#   worktree_name  directory name for the worktree (also the branch name when
#                  branch_name is omitted).
#   branch_name    optional; name of the branch to create / check out.
#
# Behavior:
#   - Worktree is created at ~/worktrees/<repo_name>/<worktree_name>.
#   - A new branch is based off `master` (falls back to `main`).
#   - If the branch already exists it is checked out into the new worktree.
#   - Prints the worktree's absolute path and copies it to the clipboard.
set -euo pipefail

die() { printf 'wt: %s\n' "$1" >&2; exit 1; }

[[ $# -ge 1 && $# -le 2 ]] || die "usage: wt <worktree_name> [branch_name]"

worktree_name=$1
branch_name=${2:-$worktree_name}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"

# Resolve the repo name from the *main* worktree's git dir so it's identical no
# matter which worktree (or the main checkout) you invoke this from.
common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
repo_name=$(basename "$(dirname "$common_dir")")

dest="$HOME/worktrees/$repo_name/$worktree_name"
[[ -e "$dest" ]] && die "destination already exists: $dest"

mkdir -p "$(dirname "$dest")"

if git show-ref --verify --quiet "refs/heads/$branch_name"; then
  # Branch already exists — check it out into the new worktree.
  git worktree add "$dest" "$branch_name" >&2
else
  # New branch — base it off master (fall back to main).
  base_branch=master
  git show-ref --verify --quiet "refs/heads/master" || base_branch=main
  git show-ref --verify --quiet "refs/heads/$base_branch" \
    || die "base branch '$base_branch' not found"
  git worktree add -b "$branch_name" "$dest" "$base_branch" >&2
fi

# stdout is just the clean path (git's progress went to stderr above).
printf '%s\n' "$dest"
command -v pbcopy >/dev/null 2>&1 && printf '%s' "$dest" | pbcopy
