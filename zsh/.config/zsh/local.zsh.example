# Copy to local.zsh (gitignored) for machine-specific, NON-secret config:
# PATHs, version managers, tool init. This file is sourced into every shell.
#
#   cp local.zsh.example local.zsh

# Local bins
# export PATH="$HOME/.local/bin:$PATH"

