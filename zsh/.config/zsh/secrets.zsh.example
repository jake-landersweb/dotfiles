# Copy to secrets.zsh (gitignored) for credentials / tokens.
# This file is sourced into every shell. Add as many exports as you need.
#
#   cp secrets.zsh.example secrets.zsh
#
# Prefer `gh auth login` (keychain) over a long-lived token where possible.

# export GH_USERNAME=""
# export GH_TOKEN=""

# For many credentials, you can also drop separate files into ~/.config/zsh/local.d/*.zsh
# (also gitignored) — e.g. local.d/aws.zsh, local.d/openai.zsh — instead of one big file.
